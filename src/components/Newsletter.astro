---
// src/components/Newsletter.astro
export interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  placeholder?: string;
  variant?: 'default' | 'compact' | 'minimal';
}

const {
  title = 'Suscríbete a nuestro Newsletter',
  subtitle = 'Recibe las últimas actualizaciones y contenido exclusivo directamente en tu correo',
  buttonText = 'Suscribirse',
  placeholder = 'Tu correo electrónico',
  variant = 'default'
} = Astro.props;

// Clases según variante
const variantClasses = {
  default: {
    container: 'p-8 md:p-12',
    title: 'text-2xl md:text-3xl',
    subtitle: 'text-base',
    input: 'px-4 py-3'
  },
  compact: {
    container: 'p-6 md:p-8',
    title: 'text-xl md:text-2xl',
    subtitle: 'text-sm',
    input: 'px-3 py-2'
  },
  minimal: {
    container: 'p-4 md:p-6',
    title: 'text-lg md:text-xl',
    subtitle: 'text-xs',
    input: 'px-3 py-2'
  }
};
---

<section class="newsletter-section">
  <div class={`bg-linear-to-br from-blue-50 to-indigo-50 rounded-2xl shadow-sm ${variantClasses[variant].container}`}>
    <div class="max-w-2xl mx-auto text-center">
      <!-- Icono decorativo -->
      <div class="inline-flex items-center justify-center w-14 h-14 bg-blue-600 rounded-full mb-4 shadow-lg">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>

      <!-- Título -->
      <h3 class={`${variantClasses[variant].title} font-bold text-gray-900 mb-2`}>
        {title}
      </h3>

      <!-- Subtítulo -->
      {subtitle && (
        <p class={`${variantClasses[variant].subtitle} text-gray-600 mb-6 max-w-md mx-auto`}>
          {subtitle}
        </p>
      )}

      <!-- Formulario -->
      <form 
        class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
        method="POST"
        action="/api/newsletter"
        data-netlify="true"
        name="newsletter"
      >
        <input 
          type="hidden" 
          name="form-name" 
          value="newsletter" 
        />
        
        <input
          type="email"
          name="email"
          required
          placeholder={placeholder}
          class={`flex-1 ${variantClasses[variant].input} bg-white border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors text-gray-900`}
          aria-label="Correo electrónico"
        />
        
        <button
          type="submit"
          class="px-6 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 whitespace-nowrap"
        >
          {buttonText}
        </button>
      </form>

      {/* Mensaje de privacidad */}
      <p class="mt-4 text-xs text-gray-500">
        No compartiremos tu correo. Puedes darte de baja en cualquier momento.
      </p>
    </div>
  </div>
</section>

<script>
  // Manejar el envío del formulario (opcional)
  document.querySelector('.newsletter-section form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const form = this;
    const email = form.querySelector('input[type="email"]').value;
    const button = form.querySelector('button[type="submit"]');
    const originalText = button.textContent;
    
    // Feedback visual
    button.textContent = 'Enviando...';
    button.disabled = true;
    
    // Simular envío (reemplazar con tu lógica real)
    setTimeout(() => {
      button.textContent = '✅ Suscrito';
      button.className = 'px-6 py-2 bg-green-600 text-white font-semibold rounded-lg';
      
      setTimeout(() => {
        button.textContent = originalText;
        button.disabled = false;
        button.className = 'px-6 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 whitespace-nowrap';
        form.querySelector('input[type="email"]').value = '';
      }, 3000);
    }, 1500);
  });
</script>

<style>
  .newsletter-section {
    scroll-margin-top: 2rem;
  }

  /* Mejora de accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .newsletter-section * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .newsletter-section form {
      flex-direction: column;
    }
    
    .newsletter-section button {
      width: 100%;
    }
  }
</style>