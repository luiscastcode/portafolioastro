 ---
// src/components/PostHeader.astro
export interface Props {
  posttitle: string;
  pubDate: string;
  autor: string;
  autorImage?: string;
  estimatedReadingTime?: number;
  updatedDate?: string;
}

const { 
  posttitle, 
  pubDate, 
  autor, 
  autorImage, 
  estimatedReadingTime,
  updatedDate 
} = Astro.props;

// Formatear fecha
const formattedDate = new Date(pubDate).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const formattedUpdatedDate = updatedDate 
  ? new Date(updatedDate).toLocaleDateString('es-ES', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : null;
---

<header class="post-header">
  <div class="post-header-inner">
    <!-- Título principal -->
    <h1 class="post-title" itemprop="headline">
      {posttitle}
    </h1>

    <!-- Meta información -->
    <div class="post-meta">
      <!-- Autor -->
      <div class="meta-item author">
        {autorImage ? (
          <img 
            src={autorImage} 
            alt={`Foto de ${autor}`} 
            class="author-avatar"
            loading="lazy"
          />
        ) : (
          <div class="author-avatar initials">
            {autor.charAt(0).toUpperCase()}
          </div>
        )}
        <span itemprop="author" class="author-name">
          {autor}
        </span>
      </div>

      <!-- Fecha de publicación -->
      <time 
        datetime={pubDate} 
        itemprop="datePublished"
        class="meta-item"
      >
        <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {formattedDate}
      </time>

      <!-- Fecha de actualización -->
      {formattedUpdatedDate && (
        <time 
          datetime={updatedDate} 
          itemprop="dateModified"
          class="meta-item updated"
        >
          <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Actualizado: {formattedUpdatedDate}
        </time>
      )}

      <!-- Tiempo de lectura -->
      {estimatedReadingTime && (
        <span class="meta-item reading-time">
          <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {estimatedReadingTime} min de lectura
        </span>
      )}
    </div>

    <!-- Separador decorativo -->
    <div class="header-divider"></div>
  </div>
</header>

<style>
  /* ========================================
     CONTENEDOR PRINCIPAL
     ======================================== */
  .post-header {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  .post-header-inner {
    background: #f8f9fa;
    border-radius: 1.5rem 1.5rem 0 0;
    padding: 2rem 2rem 1.5rem 2rem;
  }

  /* ========================================
     TÍTULO
     ======================================== */
  .post-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: #0f172a;
    margin: 0 0 1.25rem 0;
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  /* ========================================
     META INFORMACIÓN
     ======================================== */
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    font-size: 0.925rem;
    color: #475569;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
  }

  .meta-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    color: #64748b;
  }

  /* ========================================
     AUTOR
     ======================================== */
  .meta-item.author {
    gap: 0.625rem;
    padding-right: 0.75rem;
    border-right: 1px solid #e2e8f0;
  }

  .author-avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-avatar.initials {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.875rem;
    font-weight: 700;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
  }

  .author-name {
    font-weight: 600;
    color: #0f172a;
  }

  /* ========================================
     FECHA DE ACTUALIZACIÓN
     ======================================== */
  .meta-item.updated {
    color: #d97706;
  }

  .meta-item.updated .meta-icon {
    color: #d97706;
  }

  /* ========================================
     TIEMPO DE LECTURA
     ======================================== */
  .meta-item.reading-time {
    color: #64748b;
  }

  /* ========================================
     SEPARADOR DECORATIVO
     ======================================== */
  .header-divider {
    margin-top: 1.25rem;
    width: 4rem;
    height: 0.25rem;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
    border-radius: 9999px;
  }

  /* ========================================
     RESPONSIVE
     ======================================== */
  @media (max-width: 768px) {
    .post-header-inner {
      padding: 1.25rem 1.25rem 1rem 1.25rem;
      border-radius: 1rem 1rem 0 0;
    }

    .post-title {
      font-size: 1.75rem;
      line-height: 1.25;
    }

    .post-meta {
      gap: 0.375rem 0.75rem;
      font-size: 0.8rem;
    }

    .meta-item.author {
      border-right: none;
      padding-right: 0;
      width: 100%;
    }

    .author-avatar,
    .author-avatar.initials {
      width: 1.75rem;
      height: 1.75rem;
      font-size: 0.75rem;
    }

    .header-divider {
      width: 3rem;
      height: 0.2rem;
    }
  }

  @media (max-width: 480px) {
    .post-header-inner {
      padding: 1rem 1rem 0.75rem 1rem;
    }

    .post-title {
      font-size: 1.5rem;
      margin-bottom: 0.75rem;
    }

    .post-meta {
      font-size: 0.75rem;
      gap: 0.25rem 0.5rem;
    }

    .meta-icon {
      width: 0.875rem;
      height: 0.875rem;
    }

    .meta-item.updated {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>