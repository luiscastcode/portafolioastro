---
// src/components/PostRelacionados.astro
// Componente que muestra posts relacionados de forma aleatoria

export interface RelatedPost {
  frontmatter: {
    posttitle: string;
    ruta: string;
    image?: {
      src: string;
      alt: string;
    };
    pubDate: string;
    categoria?: string;
    autor: string;
    excerpt?: string;
  };
  url: string;
}

export interface Props {
  publicacionesRelacionadas: RelatedPost[];
  maxItems?: number;
  showExcerpt?: boolean;
  variant?: 'horizontal' | 'vertical' | 'grid';
  shuffle?: boolean;
}

const { 
  publicacionesRelacionadas, 
  maxItems = 5, 
  showExcerpt = true,
  variant = 'vertical',
  shuffle = true
} = Astro.props;

// Función para mezclar array (Fisher-Yates)
const shuffleArray = (array: RelatedPost[]) => {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
};

// Obtener posts aleatorios
let postsToShow = [...publicacionesRelacionadas];

if (shuffle) {
  postsToShow = shuffleArray(postsToShow);
}

// Limitar número de posts mostrados (máximo 5)
postsToShow = postsToShow.slice(0, Math.min(maxItems, 5));

// Formatear fecha
const formatDate = (date: string) => {
  try {
    return new Date(date).toLocaleDateString('es-ES', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  } catch {
    return date;
  }
};

// Determinar clases según variante
const variantClasses = {
  horizontal: 'flex flex-col md:flex-row gap-4',
  vertical: 'flex flex-col gap-4',
  grid: 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4'
};

const cardClasses = {
  horizontal: 'flex-1',
  vertical: 'w-full',
  grid: 'w-full'
};

// Contar posts disponibles
const totalAvailable = publicacionesRelacionadas.length;
const showingCount = postsToShow.length;
---



{totalAvailable > 0 && (
  <div class="post-relacionados">
    {/* Indicador de cantidad */}
    <div class="related-header">
      <span class="related-badge">
        <svg class="related-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        {showingCount} de {totalAvailable} artículos relacionados
      </span>
    </div>

    <ul class={variantClasses[variant]}>
      {postsToShow.map((post, index) => (
        <li 
          key={`${post.frontmatter.ruta}-${index}`}
          class={`related-card ${cardClasses[variant]}`}
          style={{ animationDelay: `${index * 0.08}s` }}
          itemscope 
          itemtype="https://schema.org/Article"
        >
          <a 
            href={`/${post.frontmatter.ruta}`}
            class="related-link"
            aria-label={`Leer: ${post.frontmatter.posttitle}`}
          >
            <article class="related-article">
              {/* Imagen del post */}
              {post.frontmatter.image && (
                <div class="related-image">
                  <img 
                    src={post.frontmatter.image.src} 
                    alt={post.frontmatter.image.alt || post.frontmatter.posttitle}
                    loading="lazy"
                    decoding="async"
                    itemprop="image"
                  />
                  {post.frontmatter.categoria && (
                    <span class="related-category">
                      {post.frontmatter.categoria}
                    </span>
                  )}
                </div>
              )}

              {/* Contenido del card */}
              <div class="related-content">
                {/* Título */}
                <h3 class="related-title" itemprop="headline">
                  {post.frontmatter.posttitle}
                </h3>

                {/* Extracto */}
                {showExcerpt && post.frontmatter.excerpt && (
                  <p class="related-excerpt" itemprop="description">
                    {post.frontmatter.excerpt}
                  </p>
                )}

                {/* Meta información */}
                <div class="related-meta">
                  <span class="related-author">
                    <svg class="meta-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    {post.frontmatter.autor}
                  </span>
                  <time datetime={post.frontmatter.pubDate} class="related-date">
                    <svg class="meta-icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    {formatDate(post.frontmatter.pubDate)}
                  </time>
                </div>
              </div>
            </article>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

{/* Mensaje cuando no hay posts relacionados */}
{totalAvailable === 0 && (
  <div class="related-empty">
    <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p>No hay publicaciones relacionadas disponibles</p>
  </div>
)}

<style>
  /* ========================================
     CONTENEDOR PRINCIPAL
     ======================================== */
  .post-relacionados {
    margin: 1.5rem 0;
  }

  /* ========================================
     ENCABEZADO
     ======================================== */
  .related-header {
    margin-bottom: 1rem;
  }

  .related-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    background: #f1f5f9;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #475569;
  }

  .related-icon {
    width: 1rem;
    height: 1rem;
    color: #64748b;
  }

  /* ========================================
     TARJETAS
     ======================================== */
  .related-card {
    background: #f8f9fa;
    border-radius: 0.75rem;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid #f1f5f9;
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
    height: 100%;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.08);
    border-color: #e2e8f0;
  }

  .related-link {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .related-article {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ========================================
     IMAGEN
     ======================================== */
  .related-image {
    position: relative;
    overflow: hidden;
    background: #eef2f6;
    aspect-ratio: 16/9;
    flex-shrink: 0;
  }

  .related-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .related-card:hover .related-image img {
    transform: scale(1.05);
  }

  .related-category {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: #2563eb;
    color: white;
    font-size: 0.65rem;
    font-weight: 600;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
  }

  /* ========================================
     CONTENIDO
     ======================================== */
  .related-content {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }

  .related-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    color: #0f172a;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s;
  }

  .related-card:hover .related-title {
    color: #2563eb;
  }

  .related-excerpt {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  /* ========================================
     META INFORMACIÓN
     ======================================== */
  .related-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-top: 0.75rem;
    margin-top: 0.5rem;
    border-top: 1px solid #f1f5f9;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .related-author,
  .related-date {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .meta-icon-small {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    color: #94a3b8;
  }

  /* ========================================
     ESTADO VACÍO
     ======================================== */
  .related-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    background: #f8f9fa;
    border-radius: 0.75rem;
    border: 1px dashed #e2e8f0;
    text-align: center;
    color: #94a3b8;
    font-size: 0.875rem;
  }

  .empty-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: #cbd5e1;
    margin-bottom: 0.75rem;
  }

  .related-empty p {
    margin: 0;
  }

  /* ========================================
     ANIMACIONES
     ======================================== */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========================================
     VARIANTES
     ======================================== */
  /* Grid */
  .grid .related-card {
    animation-delay: 0s;
  }

  /* Horizontal */
  .horizontal .related-card {
    flex: 1;
  }

  .horizontal .related-article {
    flex-direction: row;
  }

  .horizontal .related-image {
    aspect-ratio: 4/3;
    min-width: 180px;
    max-width: 220px;
  }

  .horizontal .related-content {
    padding: 1rem 1.25rem;
  }

  /* Vertical */
  .vertical .related-card {
    max-width: 100%;
  }

  /* ========================================
     RESPONSIVE
     ======================================== */
  @media (max-width: 768px) {
    .horizontal .related-article {
      flex-direction: column;
    }

    .horizontal .related-image {
      aspect-ratio: 16/9;
      min-width: unset;
      max-width: unset;
    }

    .related-title {
      font-size: 0.95rem;
    }

    .related-excerpt {
      font-size: 0.8rem;
      -webkit-line-clamp: 2;
    }

    .related-meta {
      font-size: 0.7rem;
      gap: 0.5rem;
    }

    .related-card {
      border-radius: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .related-content {
      padding: 0.75rem 1rem 1rem;
    }

    .related-title {
      font-size: 0.875rem;
    }

    .related-badge {
      font-size: 0.65rem;
      padding: 0.25rem 0.75rem;
    }

    .related-category {
      font-size: 0.55rem;
      padding: 0.2rem 0.6rem;
      top: 0.5rem;
      left: 0.5rem;
    }
  }

  /* ========================================
     PREFERENCIAS DE MOVIMIENTO REDUCIDO
     ======================================== */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    .related-card {
      opacity: 1;
      animation: none;
    }

    .related-card:hover {
      transform: none;
    }

    .related-card:hover .related-image img {
      transform: none;
    }
  }
</style>