---
// src/components/Navbar.astro

// Definir las rutas del menú
const menuItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Experiencia', href: '/experiencia' },
  { label: 'Servicios', href: '/#servicios' },
];

// Obtener la ruta actual
const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
};
---

<nav id="navbar" class="navbar" role="navigation" aria-label="Navegación principal">
  <div class="navbar-container">
    <!-- Logo -->
    <a href="/" class="navbar-logo" aria-label="LCastCode - Inicio">
      <span class="bg-clip-text text-transparent bg-linear-to-b from-white to-gray-500">LC</span>
      <span class="logo-highlight">astCode</span>
      <span class="logo-dot">.</span>
    </a>

    <!-- Botón hamburguesa (mobile) -->
    <button 
      id="menu-toggle" 
      class="menu-toggle" 
      aria-label="Abrir menú"
      aria-expanded="false"
      type="button"
    >
      <span class="menu-icon">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </span>
    </button>

    <!-- Menú de navegación -->
    <ul id="nav-menu" class="nav-menu" role="menubar">
      {menuItems.map((item) => (
        <li class="nav-item" role="none">
          <a
            href={item.href}
            class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
            aria-current={isActive(item.href) ? 'page' : undefined}
            role="menuitem"
          >
            <span class="nav-link-text">{item.label}</span>
            {isActive(item.href) && (
              <span class="nav-indicator" aria-hidden="true"></span>
            )}
          </a>
        </li>
      ))}
      
      <!-- Botón de acción adicional -->
      <li class="nav-item nav-cta" role="none">
        <a href="/contacto" class="btn-cta" role="menuitem">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Contratame</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  // ========================================
  // INICIALIZACIÓN INMEDIATA - Sin esperar DOMContentLoaded
  // ========================================
  (function initNavbar() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('nav-menu');
    const navbar = document.getElementById('navbar');

    // Si no existen los elementos, salir
    if (!toggle || !menu || !navbar) {
      console.warn('Navbar: Elementos no encontrados');
      return;
    }

    // ========================================
    // MENÚ MÓVIL
    // ========================================
    function toggleMenu() {
      const isOpen = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
      
      // Forzar reflow para asegurar que la animación se ejecute
      if (isOpen) {
        menu.style.display = 'flex';
        // Forzar reflow
        void menu.offsetHeight;
      } else {
        setTimeout(() => {
          if (!menu.classList.contains('open')) {
            menu.style.display = '';
          }
        }, 350);
      }
    }

    function closeMenu() {
      menu.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!menu.classList.contains('open')) {
          menu.style.display = '';
        }
      }, 350);
    }

    // Evento click del toggle
    toggle.addEventListener('click', toggleMenu);

    // Cerrar menú al hacer click en un enlace
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Cerrar menú al hacer click fuera
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target && !menu.contains(target) && !toggle.contains(target)) {
        closeMenu();
      }
    });

    // Cerrar menú al presionar ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        closeMenu();
      }
    });

    // ========================================
    // EFECTO DE SCROLL - ENCOGIMIENTO
    // ========================================
    let ticking = false;

    function handleScroll() {
      const currentScroll = window.scrollY || document.documentElement.scrollTop;
      
      if (currentScroll > 50) {
        navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    });

    // Ejecutar al cargar para verificar estado inicial
    handleScroll();

    // ========================================
    // CORRECCIÓN PARA MÓVIL: Re-evaluar al cambiar de orientación
    // ========================================
    if (window.matchMedia) {
      const mediaQuery = window.matchMedia('(max-width: 768px)');
      mediaQuery.addListener(() => {
        if (!mediaQuery.matches) {
          closeMenu();
        }
      });
    }

    // ========================================
    // CORRECCIÓN PARA NAVEGADORES MÓVILES
    // ========================================
    // En móviles, a veces el menú no se muestra correctamente
    // Forzamos la visibilidad inicial
    if (window.innerWidth <= 768) {
      // Asegurar que el menú esté oculto inicialmente
      menu.classList.remove('open');
      menu.style.display = '';
      toggle.setAttribute('aria-expanded', 'false');
    }

    console.log('Navbar inicializado correctamente');
  })();
</script>

<style>
  /* ========================================
     NAVBAR PRINCIPAL - TEMA OSCURO
     ======================================== */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid rgba(251, 191, 36, 0.08);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    height: 76px;
  }

  /* Estado encogido al hacer scroll */
  .navbar.scrolled {
    height: 60px;
    background: rgba(15, 23, 42, 0.92);
    border-bottom: 1px solid rgba(251, 191, 36, 0.15);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    transition: padding 0.35s ease;
  }

  /* ========================================
     LOGO
     ======================================== */
  .navbar-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  .navbar.scrolled .navbar-logo {
    font-size: 1.5rem;
  }

  .navbar-logo:hover {
    transform: scale(1.02);
  }

  .logo-text {
    color: #e2e8f0;
    position: relative;
  }

  .logo-highlight {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .logo-dot {
    color: #fbbf24;
    font-weight: 800;
  }

  /* ========================================
     MENÚ TOGGLE (Mobile)
     ======================================== */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    transition: background 0.2s;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .menu-toggle:hover {
    background: rgba(251, 191, 36, 0.1);
  }

  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 24px;
  }

  .menu-line {
    display: block;
    height: 2.5px;
    width: 100%;
    background: #e2e8f0;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  .menu-toggle[aria-expanded="true"] .menu-line:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
    background: #fbbf24;
  }

  .menu-toggle[aria-expanded="true"] .menu-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .menu-toggle[aria-expanded="true"] .menu-line:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
    background: #fbbf24;
  }

  /* ========================================
     MENÚ DE NAVEGACIÓN
     ======================================== */
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: all 0.3s ease;
  }

  .nav-item {
    position: relative;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 10px;
    transition: all 0.25s ease;
    position: relative;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #e2e8f0;
    background: rgba(251, 191, 36, 0.06);
  }

  .nav-link.active {
    color: #fbbf24;
    font-weight: 600;
    background: rgba(251, 191, 36, 0.08);
  }

  .nav-link-text {
    position: relative;
    z-index: 1;
  }

  .nav-indicator {
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 20px;
    height: 3px;
    background: linear-gradient(90deg, #fbbf24, #f59e0b);
    border-radius: 2px;
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from {
      width: 0;
      opacity: 0;
    }
    to {
      width: 20px;
      opacity: 1;
    }
  }

  /* ========================================
     BOTÓN CTA
     ======================================== */
  .nav-cta {
    margin-left: 0.5rem;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #0f172a;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(251, 191, 36, 0.2);
    white-space: nowrap;
  }

  .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(251, 191, 36, 0.35);
    background: linear-gradient(135deg, #fcd34d, #f59e0b);
    color: #0f172a;
  }

  .btn-cta:active {
    transform: translateY(0);
  }

  .btn-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  /* ========================================
     RESPONSIVE - MOBILE
     ======================================== */
  @media (max-width: 768px) {
    .navbar {
      height: 64px;
    }

    .navbar.scrolled {
      height: 56px;
    }

    .navbar-container {
      padding: 0 1rem;
    }

    .navbar-logo {
      font-size: 1.5rem;
    }

    .navbar.scrolled .navbar-logo {
      font-size: 1.25rem;
    }

    /* Mostrar toggle en móvil */
    .menu-toggle {
      display: flex;
    }

    /* Menú oculto por defecto en móvil */
    .nav-menu {
      position: fixed;
      top: 64px;
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 1.5rem;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      transform: translateX(100%);
      opacity: 0;
      visibility: hidden;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      border-top: 1px solid rgba(251, 191, 36, 0.08);
      /* Asegurar que el menú esté oculto inicialmente */
      display: flex !important;
      pointer-events: none;
    }

    .navbar.scrolled .nav-menu {
      top: 56px;
    }

    .nav-menu.open {
      transform: translateX(0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .nav-item {
      width: 100%;
      border-bottom: 1px solid rgba(251, 191, 36, 0.04);
    }

    .nav-item:last-child {
      border-bottom: none;
    }

    .nav-link {
      padding: 1rem 0.75rem;
      font-size: 1.125rem;
      justify-content: center;
      width: 100%;
      border-radius: 0;
      color: #94a3b8;
    }

    .nav-link:hover {
      background: rgba(251, 191, 36, 0.04);
      color: #e2e8f0;
    }

    .nav-link.active {
      background: rgba(251, 191, 36, 0.06);
      color: #fbbf24;
    }

    .nav-indicator {
      display: none;
    }

    /* Badge de página activa en móvil */
    .nav-link.active::after {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 24px;
      background: linear-gradient(180deg, #fbbf24, #f59e0b);
      border-radius: 0 4px 4px 0;
    }

    .nav-cta {
      margin-left: 0;
      margin-top: 0.5rem;
    }

    .btn-cta {
      justify-content: center;
      padding: 0.75rem;
      width: 100%;
      font-size: 1rem;
    }
  }

  /* ========================================
     RESPONSIVE - TABLET
     ======================================== */
  @media (min-width: 769px) and (max-width: 1024px) {
    .navbar-container {
      padding: 0 1.5rem;
    }

    .nav-link {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }

    .btn-cta {
      padding: 0.5rem 1rem;
      font-size: 0.8125rem;
    }
  }

  /* ========================================
     RESPONSIVE - MÓVIL PEQUEÑO
     ======================================== */
  @media (max-width: 480px) {
    .nav-menu {
      padding: 1rem;
    }
    
    .nav-link {
      padding: 0.75rem 0.5rem;
      font-size: 1rem;
    }
    
    .btn-cta {
      padding: 0.625rem;
      font-size: 0.875rem;
    }
  }

  /* ========================================
     PREFERENCIAS DE MOVIMIENTO REDUCIDO
     ======================================== */
  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .navbar-logo,
    .navbar.scrolled .navbar-logo,
    .nav-link,
    .btn-cta,
    .nav-menu,
    .menu-line {
      transition: none !important;
      animation: none !important;
    }
    .navbar-logo:hover {
      transform: none;
    }
    .btn-cta:hover {
      transform: none;
    }
    .nav-indicator {
      animation: none;
    }
  }
</style>