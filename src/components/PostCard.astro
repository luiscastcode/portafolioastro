---
// src/components/PostCard.astro
export interface Props {
  post: {
    frontmatter: {
      posttitle: string;
      ruta: string;
      pubDate: string;
      autor: string;
      image?: {
        src: string;
        alt: string;
      };
      excerpt?: string;
    };
    url: string;
  };
}

const { post } = Astro.props;
const { frontmatter } = post;

// Formatear fecha
const formattedDate = new Date(frontmatter.pubDate).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Obtener inicial del autor
const autorInitial = frontmatter.autor?.charAt(0).toUpperCase() || '?';

// URL del post
const postUrl = `/${frontmatter.ruta}`;
---

<article 
  class="group bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 flex flex-col h-full hover:-translate-y-1"
  itemscope 
  itemtype="https://schema.org/BlogPosting"
>
  <a href={postUrl} class="block h-full flex flex-col" aria-label={`Leer: ${frontmatter.posttitle}`}>
    <!-- Imagen destacada -->
    <div class="relative overflow-hidden bg-gray-100 aspect-[16/9]">
      {frontmatter.image ? (
        <img
          src={frontmatter.image.src}
          alt={frontmatter.image.alt || frontmatter.posttitle}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
          decoding="async"
          itemprop="image"
        />
      ) : (
        <div class="w-full h-full bg-linear-to-br from-blue-400 to-purple-500 flex items-center justify-center">
          <span class="text-4xl font-bold text-white opacity-50">
            {frontmatter.posttitle?.charAt(0).toUpperCase() || '?'}
          </span>
        </div>
      )}
      
      <!-- Badge de fecha -->
      <time 
        datetime={frontmatter.pubDate}
        class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-700 shadow-sm"
      >
        {formattedDate}
      </time>
    </div>

    <!-- Contenido del card -->
    <div class="p-5 flex flex-col flex-1">
      <!-- Título -->
      <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-2 mb-2">
        {frontmatter.posttitle}
      </h2>

      <!-- Extracto -->
      {frontmatter.excerpt && (
        <p class="text-gray-600 text-sm line-clamp-3 flex-1 mb-3" itemprop="description">
          {frontmatter.excerpt}
        </p>
      )}

      <!-- Meta información -->
      <div class="flex items-center justify-between pt-3 border-t border-gray-100 mt-auto">
        <div class="flex items-center gap-2">
          <!-- Avatar del autor -->
          <div class="w-7 h-7 rounded-full bg-linear-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-xs font-bold">
            {autorInitial}
          </div>
          <span class="text-xs font-medium text-gray-700" itemprop="author">
            {frontmatter.autor}
          </span>
        </div>

        <!-- Indicador de lectura -->
        <span class="text-xs text-gray-400 flex items-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          Leer más
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  /* Estilos para truncar texto */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Animación de entrada */
  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .group {
    animation: cardFadeIn 0.6s ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .group {
      animation: none;
    }
    .group-hover\:scale-110:hover {
      transform: scale(1);
    }
    .hover\:shadow-xl:hover {
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .hover\:-translate-y-1:hover {
      transform: translateY(0);
    }
  }
</style>