      position: static;
    }

    .sidebar-card {
      padding: 1rem;
    }

    .breadcrumb-nav {
      padding: 0.5rem 0.75rem;
      margin-top: 1.5rem;
    }

    .breadcrumb-item {
      font-size: 0.75rem;
    }

    .breadcrumb-separator {
      margin: 0 0.25rem;
    }

    .tags-footer {
      margin-top: 2rem;
      padding-top: 1.5rem;
    }

    .tag-link {
      font-size: 0.75rem;
      padding: 0.2rem 0.6rem;
    }
  }

  @media (max-width: 480px) {
    .blog-layout {
      padding: 0.25rem;
    }

    .blog-grid {
      gap: 1rem;
    }

    .sidebar-card {
      padding: 0.75rem;
      border-radius: 0.5rem;
    }

    .sidebar-title {
      font-size: 1rem;
    }

    .breadcrumb-nav {
      padding: 0.375rem 0.5rem;
      margin-top: 0.5rem;
    }

